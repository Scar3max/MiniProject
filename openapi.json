  "components": {
    "schemas": {
      "AnswerRequest": {
        "properties": {
          "answer": {
            "type": "string",
            "minLength": 1,
            "title": "Answer"
          },
          "client_turn_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Client Turn Id"
          }
        },
        "type": "object",
        "required": [
          "answer"
        ],
        "title": "AnswerRequest"
      },
      "AuthResponse": {
        "properties": {
          "user": {
            "$ref": "#/components/schemas/UserResponse"
          },
          "csrf_token": {
            "type": "string",
            "title": "Csrf Token"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "user",
          "csrf_token",
          "message"
        ],
        "title": "AuthResponse"
      },
      "ChangePasswordRequest": {
        "properties": {
          "current_password": {
            "type": "string",
            "title": "Current Password"
          },
          "new_password": {
            "type": "string",
            "minLength": 6,
            "title": "New Password"
          }
        },
        "type": "object",
        "required": [
          "current_password",
          "new_password"
        ],
        "title": "ChangePasswordRequest"
      },
      "DeleteDataRequest": {
        "properties": {
          "confirmation": {
            "type": "string",
            "title": "Confirmation",
            "description": "Must exactly type 'DELETE MY DATA'"
          }
        },
        "type": "object",
        "required": [
          "confirmation"
        ],
        "title": "DeleteDataRequest"
      },
      "DomainItem": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "icon": {
            "type": "string",
            "title": "Icon"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "gradient": {
            "type": "string",
            "title": "Gradient"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "icon",
          "description",
          "gradient"
        ],
        "title": "DomainItem"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LoginRequest": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest"
      },
      "ProfileUpdateRequest": {
        "properties": {
          "full_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Full Name"
          },
          "college_org": {
            "anyOf": [
              {
